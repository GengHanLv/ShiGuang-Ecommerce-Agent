OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
# 对话 / 记忆抽取 / 评测
CHAT_MODEL=gpt-4o-mini

# 本地 BGE-M3
BGE_M3_MODEL_PATH=data/models/bge-m3
EMBEDDING_DIM=1024

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=ecommerce

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

REDIS_HOST=localhost
REDIS_PORT=6380

# 登录使用 HttpOnly 会话，不再接受共享 API Key 作为用户身份
AUTH_ADMIN_USERNAME=admin
# 首次启动未设置密码时生成随机密码，仅写本机 data/auth/bootstrap-admin.json
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_USER_ID=user123
AUTH_ALLOW_REGISTER=true
# HTTPS 部署设为 true；本地 HTTP 开发用 false
AUTH_COOKIE_SECURE=false

# 跨域开发地址（使用 Vite /api 代理时不需要额外配置）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ReAct调用预算（只记录工具摘要，不展示内部思考）
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_TOOL_TIMEOUT=180

# llm 使用当前模型精排；rules 为不调用模型的型号过滤与 RRF 降级
RAG_RERANKER=llm
# auto 为 Bing RSS + DDGS 回退；也支持 bing_rss、ddgs、tavily
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_BACKENDS=auto
TAVILY_API_KEY=
# 留空允许公开网站（含媒体、论坛、商家）；填写逗号分隔域名可限制来源，支持子域
WEB_ALLOWED_DOMAINS=

# MCP 服务配置路径；不存在时启用内置 web 服务，管理接口可保存启停状态
# 第三方工具只有同时列入 allow_tools、retry_tools 且声明幂等才允许自动重试
MCP_SERVERS_FILE=data/mcp/servers.json

# PDF 中文字体，可指定允许嵌入的 TrueType 字体路径；Windows 默认尝试宋体
# 其它平台建议配置字体，未配置时使用阅读器内置 STSong 中文字体
PDF_FONT_PATH=
