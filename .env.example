# Copy with: python -m scripts.setup_env
# Put your model-provider key here. No real credential is shipped.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-provider-key
CHAT_MODEL=gpt-4o-mini
BGE_M3_MODEL_PATH=Models/bge-m3
EMBEDDING_DIM=1024
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-root-password
MYSQL_DB=ecommerce
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MINIO_ROOT_USER=ecommerce_storage
MINIO_ROOT_PASSWORD=replace-with-random-storage-password
API_KEY=replace-with-random-application-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
